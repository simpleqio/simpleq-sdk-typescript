{
  "name": "@simpleq/sdk",
  "version": "0.4.0",
  "description": "Official Node/TypeScript SDK for SimpleQ — publish jobs, verify webhook signatures, and ack/nack/defer deliveries.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "homepage": "https://docs.simpleq.io/sdk/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simpleqio/simpleq-sdk-typescript.git"
  },
  "bugs": "https://github.com/simpleqio/simpleq-sdk-typescript/issues",
  "packageManager": "pnpm@11.1.2",
  "keywords": [
    "simpleq",
    "queue",
    "jobs",
    "webhook",
    "transport",
    "sdk"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/webhooks.d.cts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/nest.d.ts",
        "default": "./dist/nest.js"
      },
      "require": {
        "types": "./dist/nest.d.cts",
        "default": "./dist/nest.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "pnpm run type-check && pnpm run build && pnpm test",
    "build": "tsup && node scripts/audit-dts.mjs",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "audit:dts": "node scripts/audit-dts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "express": "^4.17.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.15",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.7",
    "express": "^4.21.2",
    "openapi-typescript": "^7.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
